# Template for index page with search/filter
index_template = '''
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Affiliate Product Site</title>
    <link rel="manifest" href="manifest.json">
    <style>
        body {{
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #f8f9fa;
            color: #212529;
        }}
        .container {{
            max-width: 1200px;
            margin: 0 auto;
        }}
        header {{
            text-align: center;
            margin-bottom: 30px;
            padding: 20px 0;
            border-bottom: 1px solid #dee2e6;
        }}
        h1 {{
            color: #2c3e50;
            margin: 0;
        }}
        .search-bar {{
            margin: 20px 0;
            display: flex;
            gap: 10px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }}
        .search-bar input {{
            flex: 1;
            padding: 12px 16px;
            border: 2px solid #ced4da;
            border-radius: 6px;
            font-size: 16px;
            transition: border-color 0.2s;
        }}
        .search-bar input:focus {{
            outline: none;
            border-color: #86b7fe;
            box-shadow: 0 0 0 3px rgba(13,110,253,0.25);
        }}
        .search-bar button {{
            padding: 12px 24px;
            background-color: #0d6efd;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: background-color 0.2s;
        }}
        .search-bar button:hover {{
            background-color: #0b5ed7;
        }}
        .filters {{
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin: 20px 0;
            padding: 15px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0,0,0,0.05);
        }}
        .filters label {{
            font-size: 14px;
            color: #495057;
        }}
        .filters select, .filters input {{
            padding: 8px 12px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            font-size: 14px;
        }}
        .product-grid {{
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 24px;
            margin-top: 20px;
        }}
        .product-card {{
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 15px rgba(0,0,0,0.08);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
        }}
        .product-card:hover {{
            transform: translateY(-8px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.15);
        }}
        .product-image {{
            width: 100%;
            height: 220px;
            object-fit: cover;
            background-color: #f0f0f0;
        }}
        .product-info {{
            flex: 1;
            padding: 20px;
            display: flex;
            flex-direction: column;
        }}
        .product-title {{
            font-size: 20px;
            margin: 0 0 12px 0;
            color: #2c3e50;
            font-weight: 600;
            line-height: 1.4;
        }}
        .product-description {{
            flex: 1;
            color: #6c757d;
            font-size: 14px;
            line-height: 1.5;
            margin-bottom: 16px;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }}
        .product-meta {{
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: auto;
        }}
        .product-price {{
            font-size: 22px;
            color: #dc3545;
            font-weight: bold;
        }}
        .product-rating {{
            color: #ffc107;
            font-size: 18px;
        }}
        .product-tag, .product-category {{
            background-color: #e9ecef;
            padding: 4px 8px;
            border-radius: 10px;
            font-size: 12px;
        }}
        .product-tag {{
            background-color: #d4edda;
        }}
        .product-category {{
            background-color: #cce5ff;
        }}
        .affiliate-link {{
            display: block;
            text-align: center;
            background-color: #0d6efd;
            color: white;
            padding: 12px 24px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 600;
            margin-top: 16px;
            transition: background-color 0.2s;
        }}
        .affiliate-link:hover {{
            background-color: #0b5ed7;
        }}
        @media (max-width: 768px) {{
            .product-grid {{
                grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            }}
            .search-bar {{
                flex-direction: column;
            }}
        }}
        @media (max-width: 480px) {{
            .filters {{
                flex-direction: column;
                align-items: stretch;
            }}
            .filters label {{
                width: 100%;
                margin-bottom: 4px;
            }}
        }}
    </style>
</head>
<body>
    <header>
        <h1>Featured Products</h1>
        <p>Discover the best affiliate deals</p>
    </header>
    
    <div class="container">
        <div class="search-bar">
            <input type="text" id="searchInput" placeholder="Search products...">
            <button type="button" id="searchBtn">Search</button>
        </div>
        
        <div class="filters">
            <div>
                <label for="categoryFilter">Category:</label>
                <select id="categoryFilter">
                    <option value="">All Categories</option>
                    {category_options}
                </select>
            </div>
            <div>
                <label for="tagFilter">Tag:</label>
                <select id="tagFilter">
                    <option value="">All Tags</option>
                    {tag_options}
                </select>
            </div>
            <div>
                <label for="minPrice">Min Price:</label>
                <input type="number" id="minPrice" placeholder="$0">
            </div>
            <div>
                <label for="maxPrice">Max Price:</label>
                <input type="number" id="maxPrice" placeholder="$1000">
            </div>
            <button type="button" id="resetFilters">Reset Filters</button>
        </div>
        
        <div class="product-grid" id="productGrid">
            {product_cards}
        </div>
    </div>

    <script>
        // Store original products data
        const productsData = {products_json};
        
        // DOM elements
        const productGrid = document.getElementById('productGrid');
        const searchInput = document.getElementById('searchInput');
        const searchBtn = document.getElementById('searchBtn');
        const categoryFilter = document.getElementById('categoryFilter');
        const tagFilter = document.getElementById('tagFilter');
        const minPriceInput = document.getElementById('minPrice');
        const maxPriceInput = document.getElementById('maxPrice');
        const resetFiltersBtn = document.getElementById('resetFilters');
        
        // Initial render
        renderProducts(productsData);
        
        // Event listeners
        searchBtn.addEventListener('click', () => renderProducts(productsData));
        searchInput.addEventListener('keypress', (e) => {{
            if (e.key === 'Enter') renderProducts(productsData);
        }});
        categoryFilter.addEventListener('change', () => renderProducts(productsData));
        tagFilter.addEventListener('change', () => renderProducts(productsData));
        minPriceInput.addEventListener('change', () => renderProducts(productsData));
        maxPriceInput.addEventListener('change', () => renderProducts(productsData));
        resetFiltersBtn.addEventListener('click', () => {{
            searchInput.value = '';
            categoryFilter.value = '';
            tagFilter.value = '';
            minPriceInput.value = '';
            maxPriceInput.value = '';
            renderProducts(productsData);
        }});
        
        function renderProducts(products) {{
            let filtered = products;
            
            // Text search
            const searchTerm = searchInput.value.trim().toLowerCase();
            if (searchTerm) {{
                filtered = filtered.filter(p => 
                    p.name.toLowerCase().includes(searchTerm) ||
                    p.description.toLowerCase().includes(searchTerm) ||
                    p.categories.some(c => c.toLowerCase().includes(searchTerm)) ||
                    p.tags.some(t => t.toLowerCase().includes(searchTerm))
                );
            }}
            
            // Category filter
            const selectedCategory = categoryFilter.value;
            if (selectedCategory) {{
                filtered = filtered.filter(p => p.categories.includes(selectedCategory));
            }}
            
            // Tag filter
            const selectedTag = tagFilter.value;
            if (selectedTag) {{
                filtered = filtered.filter(p => p.tags.includes(selectedTag));
            }}
            
            // Price filters
            const minPrice = parseFloat(minPriceInput.value) || 0;
            const maxPrice = parseFloat(maxPriceInput.value) || Infinity;
            filtered = filtered.filter(p => {{
                const priceVal = parseFloat(p.price.replace(/[^0-9.]/g, ''));
                return !isNaN(priceVal) && priceVal >= minPrice && priceVal <= maxPrice;
            }});
            
            // Render
            if (filtered.length === 0) {{
                productGrid.innerHTML = '<p class="no-results">No products match your filters.</p>';
                return;
            }}
            
            productGrid.innerHTML = filtered.map(p => {{
                const priceNum = parseFloat(p.price.replace(/[^0-9.]/g, ''));
                const priceFormatted = priceNum.toLocaleString(undefined, {{style: 'currency', currency: 'USD'}});
                const ratingStars = '★'.repeat(Math.floor(p.rating)) + 
                                  (p.rating % 1 >= 0.5 ? '½' : '') + 
                                  '☆'.repeat(5 - Math.ceil(p.rating));
                return `
                    <div class="product-card">
                        <a href="product/${p.id}.html" class="product-link" style="text-decoration: none; color: inherit;">
                            <img src="${p.image_url}" alt="${p.name}" class="product-image" loading="lazy">
                            <div class="product-info">
                                <h2 class="product-title">${p.name}</h2>
                                <p class="product-description">${p.description}</p>
                                <div class="product-meta">
                                    <span class="product-price">{priceFormatted}</span>
                                    <span class="product-rating">${ratingStars} (${p.review_count} reviews)</span>
                                    {''.join(p.categories.map(c => `<span class="product-category">${c}</span>`))}
                                    {''.join(p.tags.map(t => `<span class="product-tag">${t}</span>`))}
                                </div>
                                <a href="product/${p.id}.html" class="affiliate-link">View Product →</a>
                            </div>
                        </a>
                    </div>
                `;
            }}).join('');
        }}
    </script>
</body>
</html>
'''

# Generate product cards for index (static version for non-JS fallback)
def generate_product_card(product):
    price_num = float(product['price'].replace('$', '').replace(',', ''))
    price_formatted = f"${price_num:,.2f}"
    full_stars = int(product['rating'])
    half_star = (product['rating'] - full_stars) >= 0.5
    empty_stars = 5 - full_stars - (1 if half_star else 0)
    stars = '★' * full_stars + ('½' if half_star else '') + '☆' * empty_stars
    
    categories_html = ''.join([f'<span class="product-category">{cat}</span>' for cat in product['categories']])
    tags_html = ''.join([f'<span class="product-tag">{tag}</span>' for tag in product['tags']])
    
    return f'''
        <div class="product-card">
            <a href="product/{product['id']}.html" class="product-link" style="text-decoration: none; color: inherit;">
                <img src="{product['image_url']}" alt="{product['name']}" class="product-image" loading="lazy">
                <div class="product-info">
                    <h2 class="product-title">{product['name']}</h2>
                    <p class="product-description">{product['description']}</p>
                    <div class="product-meta">
                        <span class="product-price">{price_formatted}</span>
                        <span class="product-rating">{stars} ({product['review_count']} reviews)</span>
                        {categories_html}
                        {tags_html}
                    </div>
                    <a href="product/{product['id']}.html" class="affiliate-link">View Product →</a>
                </div>
            </a>
        </div>
    '''

# Generate product cards
product_cards = ''.join([generate_product_card(p) for p in products])

# Generate filter options
all_categories = sorted(list(set(cat for p in products for cat in p['categories'])))
all_tags = sorted(list(set(tag for p in products for tag in p['tags'])))

category_options = ''.join([f'<option value="{cat}">{cat}</option>' for cat in all_categories])
tag_options = ''.join([f'<option value="{tag}">{tag}</option>' for tag in all_tags])

# Write index.html
with open(dist_dir / 'index.html', 'w') as f:
    f.write(index_template.format(
        product_cards=product_cards,
        category_options=category_options,
        tag_options=tag_options,
        products_json=json.dumps(products)
    ))

# Write product pages
for product in products:
    product_dir = dist_dir / 'product'
    product_dir.mkdir(exist_ok=True)
    
    # For price in schema.org, extract numeric value
    price_value = product['price'].replace('$', '').replace(',', '')
    
    with open(product_dir / f"{product['id']}.html", 'w') as f:
        f.write(product_template.format(
            product_name=product['name'],
            description=product['description'],
            price=product['price'],
            price_value=price_value,
            image_url=product['image_url'],
            affiliate_link=product['affiliate_link'],
            categories=product['categories'],
            tags=product['tags'],
            rating=product['rating'],
            review_count=product['review_count'],
            rating_stars='★' * int(product['rating']) + ('½' if (product['rating'] - int(product['rating'])) >= 0.5 else '') + '☆' * (5 - int(product['rating']) - (1 if (product['rating'] - int(product['rating'])) >= 0.5 else 0))
        ))

# Generate sitemap.xml
def generate_sitemap(base_url="https://Stijnman.github.io/affiliate-framework"):
    urls = []
    # Home page
    urls.append(f"  <url>\n    <loc>{base_url}/</loc>\n    <changefreq>daily</changefreq>\n    <priority>1.0</priority>\n  </url>")
    # Product pages
    for product in products:
        urls.append(f"  <url>\n    <loc>{base_url}/product/{product['id']}.html</loc>\n    <changefreq>monthly</changefreq>\n    <priority>0.8</priority>\n  </url>")
    
    sitemap = f'''<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{chr(10).join(urls)}
</urlset>'''
    
    with open(dist_dir / 'sitemap.xml', 'w') as f:
        f.write(sitemap)

# Generate robots.txt
robots_txt = '''User-agent: *
Allow: /
Disallow: /admin/
Disallow: /private/

Sitemap: https://Stijnman.github.io/affiliate-framework/sitemap.xml
'''
with open(dist_dir / 'robots.txt', 'w') as f:
    f.write(robots_txt)

# Generate manifest.json for PWA
manifest = {
    "name": "Affiliate Framework",
    "short_name": "AffiliateSite",
    "description": "Modern affiliate product platform",
    "start_url": ".",
    "display": "standalone",
    "background_color": "#ffffff",
    "theme_color": "#0d6efd",
    "icons": [
        {
            "src": "icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ]
}
with open(dist_dir / 'manifest.json', 'w') as f:
    json.dump(manifest, f, indent=2)

# Create placeholder icons (we'll create simple colored squares as placeholders)
# In a real implementation, you'd use actual icons
from PIL import Image, ImageDraw
try:
    # Create 192x192 icon
    img192 = Image.new('RGB', (192, 192), color='#0d6efd')
    draw192 = ImageDraw.Draw(img192)
    draw192.rectangle([40, 40, 152, 152], fill='white')
    img192.save(dist_dir / 'icon-192.png')
    
    # Create 512x512 icon
    img512 = Image.new('RGB', (512, 512), color='#0d6efd')
    draw512 = ImageDraw.Draw(img512)
    draw512.rectangle([120, 120, 392, 392], fill='white')
    img512.save(dist_dir / 'icon-512.png')
except Exception as e:
    # If PIL is not available, create empty files or skip
    print(f"Could not generate icons: {e}")
    # Create empty files to avoid missing file errors
    (dist_dir / 'icon-192.png').touch()
    (dist_dir / 'icon-512.png').touch()

# Generate a simple service worker for offline caching
sw_content = '''
const CACHE_NAME = 'affiliate-framework-v1';
const urlsToCache = [
  '/',
  '/index.html',
  '/manifest.json',
  '/icon-192.png',
  '/icon-512.png'
];

self.addEventListener('install', event => {
  event.waitUntil(
    caches.open(CACHE_NAME)
      .then(cache => cache.addAll(urlsToCache))
  );
});

self.addEventListener('fetch', event => {
  event.respondWith(
    caches.match(event.request)
      .then(response => {
        return response || fetch(event.request);
      })
  );
});
'''
with open(dist_dir / 'sw.js', 'w') as f:
    f.write(sw_content)

# Register service worker in index.html (already done via manifest? Actually need to add script)
# We'll update the index template to include service worker registration, but for simplicity we'll add a note.
# Instead, let's just add a simple script at the end of index.html to register SW if supported.
# We'll do that by modifying the index template above, but we already wrote it.
# For now, we'll just create the file and note that it needs to be registered.

print(f"Generated site for {len(products)} products in {dist_dir}")
print("Generated: sitemap.xml, robots.txt, manifest.json, sw.js, and placeholder icons")